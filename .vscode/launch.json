{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug betaflight_gazebo_bridge",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/betaflight_gazebo_bridge",
      "args": [
        "--config",
        "${workspaceFolder}/config/bridge.yaml"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: build debug",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
