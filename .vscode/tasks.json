{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "dependsOn": [
        "CMake: configure debug"
      ]
    },
    {
      "label": "Betaflight: select and build stable SITL",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/build_betaflight_sitl.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Run betaflight_gazebo_bridge",
      "type": "shell",
      "command": "${workspaceFolder}/build/debug/betaflight_gazebo_bridge",
      "args": [
        "--config",
        "${workspaceFolder}/config/bridge.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "CMake: build debug"
      ]
    },
    {
      "label": "Stack: gazebo",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run_quadcopter_world.sh",
      "args": [
        "-r"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "betaflight-stack",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stack: sitl",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run_betaflight_sitl.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "betaflight-stack",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stack: bridge",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run_bridge.sh",
      "args": [
        "${workspaceFolder}/config/bridge.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "betaflight-stack",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "CMake: build debug"
      ]
    },
    {
      "label": "Stack: websockify",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "websockify",
        "127.0.0.1:6761",
        "127.0.0.1:5761"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "group": "betaflight-stack",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Stack: run all",
      "dependsOn": [
        "Stack: gazebo",
        "Stack: sitl",
        "Stack: bridge",
        "Stack: websockify"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Stack: run tmuxp",
      "type": "shell",
      "command": "tmuxp",
      "args": [
        "load",
        "${workspaceFolder}/config/run_sim.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test: Betaflight ALT HOLD",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/run_althold_test.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
