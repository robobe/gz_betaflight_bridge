{
  "window.title": "${rootName} [${activeRepositoryBranchName}]${separator}${activeEditorShort}",
  "cmake.configureOnOpen": true,
  "cmake.useCMakePresets": "always",
  "cmake.buildDirectory": "${workspaceFolder}/build/debug",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
  "files.associations": {
    "iostream": "cpp"
  },
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/include",
    "${workspaceFolder}/src",
    "/usr/local/include",
    "/usr/include"
  ]
}
