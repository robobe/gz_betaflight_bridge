# Betaflight SITL mode setup for bridge and MSP hover smoke tests.
#
# CLI format:
# aux <slot> <mode_id> <aux_index> <start_us> <end_us> <logic> <linked_mode>
#
# mode_id:
#   0 = ARM
#   1 = ANGLE
#   3 = ALTHOLD
#
# aux_index is zero-based:
#   0 = AUX1 / RC channel 5
#   1 = AUX2 / RC channel 6
#   2 = AUX3 / RC channel 7
#
# logic:
#   0 = OR

# MSP hover sends RC through MSP_SET_RAW_RC on the UART1 TCP MSP endpoint.
# Disable SITL UDP RC and make MSP the active receiver source.
feature -RX_UDP
feature RX_MSP

# AUX1 high arms.
aux 0 0 0 1700 2100 0 0

# AUX2 high enables ANGLE mode.
aux 1 1 1 1700 2100 0 0

# AUX3 high enables native Betaflight altitude hold. Keep this switch low
# while arming; Betaflight prevents arming while ALTHOLD is selected.
aux 2 3 2 1700 2100 0 0

# The X3 model hovers near the top of Betaflight's supported ALT HOLD hover
# range. Use an explicit baseline so mode entry does not depend on RC shaping.
set ap_hover_throttle = 1700

save
