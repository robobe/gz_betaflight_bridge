<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="quadcopter_navigation">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter"/>

    <scene>
      <ambient>0.7 0.7 0.7</ambient>
      <background>0.55 0.75 0.95</background>
      <grid>true</grid>
    </scene>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Navigation World</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.55 0.75 0.95</background_color>
        <camera_pose>-12 -14 10 0 0.45 0.75</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu"/>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">290</property>
          <property type="double" key="height">110</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="ImageDisplay" name="Front Camera">
        <gz-gui>
          <title>Front Camera</title>
          <property key="state" type="string">docked</property>
        </gz-gui>
        <topic>/X3/front_camera/image</topic>
        <topic_picker>false</topic_picker>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 30 0.1</size></box></geometry>
        </collision>
        <visual name="grass">
          <geometry><box><size>40 30 0.1</size></box></geometry>
          <material><ambient>0.18 0.48 0.16 1</ambient><diffuse>0.22 0.58 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- POI 1: blue takeoff pad at the route origin. -->
    <model name="poi_1_takeoff">
      <static>true</static>
      <pose>0 0 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>1</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.05 0.25 0.9 1</ambient><diffuse>0.05 0.35 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- POI 2: a 2.6 m wide flight gate. -->
    <model name="poi_2_gate">
      <static>true</static>
      <pose>5 0 0 0 0 0</pose>
      <link name="link">
        <collision name="left"><pose>0 1.6 1.5 0 0 0</pose><geometry><box><size>0.25 0.25 3</size></box></geometry></collision>
        <collision name="right"><pose>0 -1.6 1.5 0 0 0</pose><geometry><box><size>0.25 0.25 3</size></box></geometry></collision>
        <collision name="top"><pose>0 0 3 0 0 0</pose><geometry><box><size>0.25 3.45 0.25</size></box></geometry></collision>
        <visual name="left"><pose>0 1.6 1.5 0 0 0</pose><geometry><box><size>0.25 0.25 3</size></box></geometry><material><ambient>1 0.55 0.02 1</ambient><diffuse>1 0.65 0.02 1</diffuse></material></visual>
        <visual name="right"><pose>0 -1.6 1.5 0 0 0</pose><geometry><box><size>0.25 0.25 3</size></box></geometry><material><ambient>1 0.55 0.02 1</ambient><diffuse>1 0.65 0.02 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 3 0 0 0</pose><geometry><box><size>0.25 3.45 0.25</size></box></geometry><material><ambient>1 0.55 0.02 1</ambient><diffuse>1 0.65 0.02 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Tree cluster leaves a slalom corridor through the middle. -->
    <model name="tree_north">
      <static>true</static><pose>8 3 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry></collision>
        <collision name="crown"><pose>0 0 3.4 0 0 0</pose><geometry><sphere><radius>1.4</radius></sphere></geometry></collision>
        <visual name="trunk"><pose>0 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>3</length></cylinder></geometry><material><ambient>0.35 0.16 0.05 1</ambient><diffuse>0.45 0.22 0.07 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.4 0 0 0</pose><geometry><sphere><radius>1.4</radius></sphere></geometry><material><ambient>0.04 0.35 0.05 1</ambient><diffuse>0.05 0.5 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tree_south">
      <static>true</static><pose>9 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk"><pose>0 0 1.25 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>2.5</length></cylinder></geometry></collision>
        <collision name="crown"><pose>0 0 3 0 0 0</pose><geometry><sphere><radius>1.25</radius></sphere></geometry></collision>
        <visual name="trunk"><pose>0 0 1.25 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>2.5</length></cylinder></geometry><material><ambient>0.35 0.16 0.05 1</ambient><diffuse>0.45 0.22 0.07 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3 0 0 0</pose><geometry><sphere><radius>1.25</radius></sphere></geometry><material><ambient>0.04 0.35 0.05 1</ambient><diffuse>0.05 0.5 0.08 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tree_far">
      <static>true</static><pose>14 4.5 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>2.8</length></cylinder></geometry></collision>
        <collision name="crown"><pose>0 0 3.2 0 0 0</pose><geometry><sphere><radius>1.3</radius></sphere></geometry></collision>
        <visual name="trunk"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>2.8</length></cylinder></geometry><material><ambient>0.35 0.16 0.05 1</ambient><diffuse>0.45 0.22 0.07 1</diffuse></material></visual>
        <visual name="crown"><pose>0 0 3.2 0 0 0</pose><geometry><sphere><radius>1.3</radius></sphere></geometry><material><ambient>0.04 0.35 0.05 1</ambient><diffuse>0.05 0.5 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- POI 3: house with a contrasting roof and doorway. -->
    <model name="poi_3_house">
      <static>true</static><pose>13 -4 0 0 0 0</pose>
      <link name="link">
        <collision name="body"><pose>0 0 1.5 0 0 0</pose><geometry><box><size>4 3.5 3</size></box></geometry></collision>
        <collision name="roof"><pose>0 0 3.35 0 0 0</pose><geometry><box><size>4.6 4.1 0.7</size></box></geometry></collision>
        <visual name="body"><pose>0 0 1.5 0 0 0</pose><geometry><box><size>4 3.5 3</size></box></geometry><material><ambient>0.82 0.66 0.42 1</ambient><diffuse>0.9 0.74 0.48 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 3.35 0 0 0</pose><geometry><box><size>4.6 4.1 0.7</size></box></geometry><material><ambient>0.55 0.08 0.04 1</ambient><diffuse>0.7 0.1 0.05 1</diffuse></material></visual>
        <visual name="door"><pose>-2.01 0 0.9 0 0 0</pose><geometry><box><size>0.05 0.9 1.8</size></box></geometry><material><ambient>0.15 0.08 0.03 1</ambient><diffuse>0.25 0.12 0.04 1</diffuse></material></visual>
      </link>
    </model>

    <!-- POI 4: tall tower for orbit and altitude practice. -->
    <model name="poi_4_tower">
      <static>true</static><pose>17 3 0 0 0 0</pose>
      <link name="link">
        <collision name="shaft"><pose>0 0 3 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>6</length></cylinder></geometry></collision>
        <collision name="top"><pose>0 0 6.2 0 0 0</pose><geometry><sphere><radius>1</radius></sphere></geometry></collision>
        <visual name="shaft"><pose>0 0 3 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>6</length></cylinder></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 6.2 0 0 0</pose><geometry><sphere><radius>1</radius></sphere></geometry><material><ambient>0.8 0.05 0.05 1</ambient><diffuse>1 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- POI 5: yellow destination pad beyond the obstacles. -->
    <model name="poi_5_finish">
      <static>true</static><pose>18 -7 0.08 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>1.2</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>1.2</radius><length>0.08</length></cylinder></geometry><material><ambient>0.9 0.75 0.02 1</ambient><diffuse>1 0.85 0.03 1</diffuse></material></visual>
        <visual name="center"><pose>0 0 0.06 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>0.03</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Scattered rocks along the north-west side of the map. -->
    <model name="rock_field">
      <static>true</static>
      <link name="link">
        <collision name="rock_1"><pose>-7 6 0.55 0 0.15 0.3</pose><geometry><ellipsoid><radii>1.3 0.9 0.65</radii></ellipsoid></geometry></collision>
        <collision name="rock_2"><pose>-4 9 0.4 0.1 -0.2 -0.4</pose><geometry><ellipsoid><radii>0.9 0.65 0.5</radii></ellipsoid></geometry></collision>
        <collision name="rock_3"><pose>1 10 0.7 -0.1 0.2 0</pose><geometry><ellipsoid><radii>1.5 1.1 0.8</radii></ellipsoid></geometry></collision>
        <visual name="rock_1"><pose>-7 6 0.55 0 0.15 0.3</pose><geometry><ellipsoid><radii>1.3 0.9 0.65</radii></ellipsoid></geometry><material><ambient>0.3 0.31 0.32 1</ambient><diffuse>0.43 0.44 0.45 1</diffuse></material></visual>
        <visual name="rock_2"><pose>-4 9 0.4 0.1 -0.2 -0.4</pose><geometry><ellipsoid><radii>0.9 0.65 0.5</radii></ellipsoid></geometry><material><ambient>0.32 0.3 0.28 1</ambient><diffuse>0.46 0.43 0.4 1</diffuse></material></visual>
        <visual name="rock_3"><pose>1 10 0.7 -0.1 0.2 0</pose><geometry><ellipsoid><radii>1.5 1.1 0.8</radii></ellipsoid></geometry><material><ambient>0.28 0.3 0.31 1</ambient><diffuse>0.4 0.43 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- South-west warehouse provides a large camera and lidar landmark. -->
    <model name="warehouse">
      <static>true</static><pose>-11 -8 0 0 0 0</pose>
      <link name="link">
        <collision name="body"><pose>0 0 2 0 0 0</pose><geometry><box><size>5 4 4</size></box></geometry></collision>
        <visual name="body"><pose>0 0 2 0 0 0</pose><geometry><box><size>5 4 4</size></box></geometry><material><ambient>0.25 0.32 0.38 1</ambient><diffuse>0.35 0.45 0.52 1</diffuse></material></visual>
        <visual name="door"><pose>2.51 0 1.35 0 0 0</pose><geometry><box><size>0.05 2.4 2.7</size></box></geometry><material><ambient>0.12 0.13 0.14 1</ambient><diffuse>0.18 0.2 0.22 1</diffuse></material></visual>
        <visual name="stripe"><pose>2.54 0 3.45 0 0 0</pose><geometry><box><size>0.04 3.2 0.3</size></box></geometry><material><ambient>0.9 0.65 0.02 1</ambient><diffuse>1 0.75 0.03 1</diffuse></material></visual>
      </link>
    </model>

    <!-- A second gate encourages a return route through the west side. -->
    <model name="west_flight_gate">
      <static>true</static><pose>-5 -2 0 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="left"><pose>0 1.4 1.4 0 0 0</pose><geometry><box><size>0.22 0.22 2.8</size></box></geometry></collision>
        <collision name="right"><pose>0 -1.4 1.4 0 0 0</pose><geometry><box><size>0.22 0.22 2.8</size></box></geometry></collision>
        <collision name="top"><pose>0 0 2.8 0 0 0</pose><geometry><box><size>0.22 3 0.22</size></box></geometry></collision>
        <visual name="left"><pose>0 1.4 1.4 0 0 0</pose><geometry><box><size>0.22 0.22 2.8</size></box></geometry><material><ambient>0.65 0.05 0.8 1</ambient><diffuse>0.8 0.08 1 1</diffuse></material></visual>
        <visual name="right"><pose>0 -1.4 1.4 0 0 0</pose><geometry><box><size>0.22 0.22 2.8</size></box></geometry><material><ambient>0.65 0.05 0.8 1</ambient><diffuse>0.8 0.08 1 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 2.8 0 0 0</pose><geometry><box><size>0.22 3 0.22</size></box></geometry><material><ambient>0.65 0.05 0.8 1</ambient><diffuse>0.8 0.08 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Utility tanks on the south edge. -->
    <model name="utility_tanks">
      <static>true</static><pose>5 -10 0 0 0 0</pose>
      <link name="link">
        <collision name="tank_1"><pose>-1 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry></collision>
        <collision name="tank_2"><pose>1 0 1.1 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>2.2</length></cylinder></geometry></collision>
        <visual name="tank_1"><pose>-1 0 1.5 0 0 0</pose><geometry><cylinder><radius>0.8</radius><length>3</length></cylinder></geometry><material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.78 0.8 0.82 1</diffuse></material></visual>
        <visual name="tank_2"><pose>1 0 1.1 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>2.2</length></cylinder></geometry><material><ambient>0.12 0.45 0.65 1</ambient><diffuse>0.16 0.58 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Narrow obstacle poles distributed across otherwise open areas. -->
    <model name="navigation_poles">
      <static>true</static>
      <link name="link">
        <collision name="pole_nw"><pose>-10 3 2 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry></collision>
        <collision name="pole_ne"><pose>11 9 2.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry></collision>
        <collision name="pole_se"><pose>11 -10 2 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry></collision>
        <visual name="pole_nw"><pose>-10 3 2 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry><material><ambient>0.8 0.8 0.05 1</ambient><diffuse>1 1 0.08 1</diffuse></material></visual>
        <visual name="pole_ne"><pose>11 9 2.5 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>5</length></cylinder></geometry><material><ambient>0.8 0.8 0.05 1</ambient><diffuse>1 1 0.08 1</diffuse></material></visual>
        <visual name="pole_se"><pose>11 -10 2 0 0 0</pose><geometry><cylinder><radius>0.15</radius><length>4</length></cylinder></geometry><material><ambient>0.8 0.8 0.05 1</ambient><diffuse>1 1 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Low barrier line: fly around it or practice crossing above 1.2 m. -->
    <model name="training_barriers">
      <static>true</static><pose>2 6 0 0 0 0.35</pose>
      <link name="link">
        <collision name="barrier"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>7 0.3 1.2</size></box></geometry></collision>
        <visual name="barrier"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>7 0.3 1.2</size></box></geometry><material><ambient>0.85 0.25 0.02 1</ambient><diffuse>1 0.32 0.03 1</diffuse></material></visual>
        <visual name="stripe_1"><pose>-2 0.16 0.6 0 0 0</pose><geometry><box><size>0.5 0.02 1.2</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_2"><pose>0 0.16 0.6 0 0 0</pose><geometry><box><size>0.5 0.02 1.2</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="stripe_3"><pose>2 0.16 0.6 0 0 0</pose><geometry><box><size>0.5 0.02 1.2</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://betaflight_x3_sensor</uri>
      <name>X3</name>
      <pose>0 0 0.35 0 0 0</pose>
    </include>
  </world>
</sdf>
